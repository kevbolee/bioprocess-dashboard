{
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "database": {
    "path": "bioreactor_data.db",
    "retention_days": 90
  },
  "nova": {
    "url": "opc.tcp://flexiiinterface:59888/NovaBiomedical",
    "poll_interval_seconds": 120
  },
  "vicell": {
    "watch_folder": "",
    "poll_interval_seconds": 60
  },
  "opc": {
    "protocol": "SIMULATE",
    "poll_interval_seconds": 5,
    "notes": [
      "Set protocol to OPC_UA when connecting to real DASware machines.",
      "Both DASware computers run OPC UA on port 51530.",
      "The OPC UA server starts successfully even when 'No license available for DASware connect' appears in DASware logs.",
      "Node IDs below follow the DASware 6 domain hierarchy: Plant1/UnitAlias/Domain/SubDomain/Variable",
      "Use the OPC UA Tag Browser in the dashboard sidebar to confirm exact node IDs from each machine."
    ],
    "servers": [
      {
        "name": "DASware-Scivario",
        "type": "OPC_UA",
        "url": "opc.tcp://CTPCOG910098:51530/UA/connectServer",
        "plant_alias": "Plant1",
        "enabled": false,
        "note": "Hostname CTPCOG910098, IP 192.168.137.8 (also has 10.10.10.11 for local Scivario LAN). DASware v6.7.1.0. Confirmed from Scivario/Connect/logs/debug.txt."
      },
      {
        "name": "DASware-DASbox",
        "type": "OPC_UA",
        "url": "opc.tcp://CTPCMO508723:51530/UA/connectServer",
        "plant_alias": "Plant1",
        "enabled": false,
        "note": "Hostname CTPCMO508723, IP 192.168.137.7. DASware v6.5.0.6. Confirmed from Dasbox/Connect/logs/debug.txt."
      }
    ]
  },
