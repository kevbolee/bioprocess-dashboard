{
  "server": {
    "host": "0.0.0.0",
    "port": 8000
  },
  "database": {
    "path": "bioreactor_data.db",
    "note": "No automatic data purging — all historical data is retained indefinitely."
  },
  "nova": {
    "url": "opc.tcp://flexiiinterface:59888/NovaBiomedical",
    "poll_interval_seconds": 120
  },
  "vicell": {
    "watch_folder": "c:/vicell",
    "poll_interval_seconds": 60
  },
  "opc": {
    "protocol": "OPC_UA",
    "poll_interval_seconds": 60,
    "notes": [
      "Set protocol to OPC_UA when connecting to real DASware machines.",
      "Both DASware computers run OPC UA on port 51530.",
      "The OPC UA server starts successfully even when 'No license available for DASware connect' appears in DASware logs.",
      "Node IDs follow the DASware connect manual (chapter 6): ns=2;s=Unit<x>/<Domain>/PV",
      "Use the OPC UA Tag Browser in the dashboard sidebar to verify node IDs if reads fail."
    ],
    "servers": [
      {
        "name": "DASware-Scivario",
        "type": "OPC_UA",
        "url": "opc.tcp://CTPCOG910098:51510/UA/DasgipCoreServer",
        "plant_alias": "Plant1",
        "enabled": true,
        "note": "Hostname CTPCOG910098, IP 192.168.137.8. DASware v6.7.1.0. URL confirmed from scivarioOPC.txt — identical config to DASbox. Port 51510 / DasgipCoreServer. Domain names from XML: pH (lowercase h), Temperature/Sensor, Agitation/Actuator, PumpA-K/Actuator, Pressure/Sensor."
      },
      {
        "name": "DASware-DASbox",
        "type": "OPC_UA",
        "url": "opc.tcp://CTPCMO508723:51510/UA/DasgipCoreServer",
        "plant_alias": "Plant1",
        "enabled": true,
        "note": "Hostname CTPCMO508723, IP 192.168.137.7. DASware v6.5.0.6. URL confirmed from dasboxOPC.xml (DASware Connect config). Domain names from XML: pH (lowercase h), DO, Temperature/Sensor, Agitation/Actuator, PumpA-K/Actuator, Pressure/Sensor, Gassing, Offgas, Reactor. Node ID paths TBC — run probe_opc_paths.py with an active batch to confirm exact format including subdomain level."
      }
    ]
  },
