    "notes": [
      "Both DASware machines use DasgipCoreServer on port 51510 (confirmed from OPC XML configs).",
      "Domain names from XML: pH (lowercase h), Temperature, DO, Redox, Level, ConductivityA/B,",
      "  Volume, Agitation/Actuator, Gassing, Overlay, Offgas, Turbidity, Reactor,",
      "  Pressure/Sensor, UserLoopA-D, PumpA-K/Actuator, BalanceA-D.",
      "Node ID variable paths (PV etc.) to be confirmed by running probe_opc_paths.py",
      "  with an active batch — paths may include a subdomain level (e.g. Temperature/Sensor/PV).",
      "Tags that return BadNodeIdUnknown (hardware not connected) are silently skipped."
    ],
    "servers": [
      {
        "name": "DASware-Scivario",
        "type": "OPC_UA",
        "url": "opc.tcp://CTPCOG910098:51510/UA/DasgipCoreServer",
        "plant_alias": "Plant1",
        "enabled": true,
        "note": "Hostname CTPCOG910098, IP 192.168.137.8. DASware v6.7.1.0. URL confirmed from scivarioOPC.txt — identical config to DASbox. Port 51510 / DasgipCoreServer. Domain names from XML: pH (lowercase h), Temperature/Sensor, Agitation/Actuator, PumpA-K/Actuator, Pressure/Sensor."
      },
      {
        "name": "DASware-DASbox",
        "type": "OPC_UA",
        "url": "opc.tcp://CTPCMO508723:51510/UA/DasgipCoreServer",
        "plant_alias": "Plant1",
        "enabled": true,
