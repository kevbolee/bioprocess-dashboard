# credentials — never commit
.env

# database (runtime data, not source)
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# presentation screenshots (added by user)
presentation/screenshots/

# DASware Connect software installation (binaries, not source)
Dasbox/Connect/*.dll
Dasbox/Connect/*.exe
Dasbox/Connect/*.pdb
Dasbox/Connect/*.json
Dasbox/Connect/*.xml
Dasbox/Connect/*.config
Scivario/Connect/*.dll
Scivario/Connect/*.exe
Scivario/Connect/*.pdb
Scivario/Connect/*.json
Scivario/Connect/*.xml
Scivario/Connect/*.config

# Excel files
*.xlsx

# PowerPoint presentations (large binaries)
*.pptx

# Instrument export data and hardware-specific folders (runtime, not source)
NOVAexport/
BioHTExport/
vicellexport/
excelexport/
Dasbox/
Scivario/
MAST/

# DASware Connect full installation — ignore everything except logs
Dasbox/Connect/*
!Dasbox/Connect/logs/
Dasbox/Connect/logs/*
!Dasbox/Connect/logs/**/*.txt
Scivario/Connect/*
!Scivario/Connect/logs/
Scivario/Connect/logs/*
!Scivario/Connect/logs/**/*.txt

# DASware ConnectConfig utility (binaries)
Dasbox/ConnectConfig/
Scivario/ConnectConfig/
